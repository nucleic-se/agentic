{
  "name": "@nucleic-se/agentic",
  "version": "0.2.0",
  "description": "Lean domain-agnostic agent primitives for prompts, graphs, tools, providers, and runtime composition.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:nucleic-se/agentic.git"
  },
  "bugs": {
    "url": "https://github.com/nucleic-se/agentic/issues"
  },
  "homepage": "https://github.com/nucleic-se/agentic#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./llm": {
      "types": "./dist/contracts/llm.d.ts",
      "import": "./dist/contracts/llm.js"
    },
    "./tool-runtime": {
      "types": "./dist/contracts/tool-runtime.d.ts",
      "import": "./dist/contracts/tool-runtime.js"
    },
    "./agent-contracts": {
      "types": "./dist/contracts/agent.d.ts",
      "import": "./dist/contracts/agent.js"
    },
    "./tool-policy": {
      "types": "./dist/contracts/IToolPolicy.d.ts",
      "import": "./dist/contracts/IToolPolicy.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./harness": {
      "types": "./dist/runtime/harness/index.d.ts",
      "import": "./dist/runtime/harness/index.js"
    },
    "./harness/sqlite": {
      "types": "./dist/runtime/harness/stores.d.ts",
      "import": "./dist/runtime/harness/stores.js"
    },
    "./harness/web": {
      "types": "./dist/runtime/harness/ui/web.d.ts",
      "import": "./dist/runtime/harness/ui/web.js"
    },
    "./harness/terminal": {
      "types": "./dist/runtime/harness/ui/terminal.d.ts",
      "import": "./dist/runtime/harness/ui/terminal.js"
    },
    "./execution": {
      "types": "./dist/runtime/execution.d.ts",
      "import": "./dist/runtime/execution.js"
    },
    "./context": {
      "types": "./dist/runtime/context.d.ts",
      "import": "./dist/runtime/context.js"
    },
    "./testing": {
      "types": "./dist/runtime/testing/index.d.ts",
      "import": "./dist/runtime/testing/index.js"
    },
    "./evaluation": {
      "types": "./dist/runtime/evaluation/context.d.ts",
      "import": "./dist/runtime/evaluation/context.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "agent": "node dist/demo/agent/main.js",
    "agent:web": "node dist/demo/agent/main.js --web",
    "test:reliability": "vitest run runtime/harness/crash-recovery.test.ts runtime/testing runtime/evaluation",
    "eval:retention:live": "npm run build && node dist/runtime/evaluation/retention-live-cli.js",
    "eval:retention": "npm run build && node dist/runtime/evaluation/retention-cli.js",
    "eval:context": "npm run build && node dist/runtime/evaluation/context-cli.js",
    "eval:live": "npm run build && node dist/runtime/evaluation/live-cli.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@openai-oauth/core": "2.0.0",
    "@openai-oauth/local": "2.0.0"
  }
}
